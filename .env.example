# Copy to .env.local and fill in. Never commit real values.
# On Vercel, add the same names under Project → Settings → Environment Variables.

# true = demo data in the browser, no backend needed. Set to false once Appwrite is set up.
NEXT_PUBLIC_USE_MOCK_API=true

# Appwrite (public: safe in the browser)
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=
NEXT_PUBLIC_APPWRITE_DATABASE_ID=tiqra

# Appwrite server key (SECRET: server only). Scopes: databases.*, collections.*, attributes.*,
# indexes.*, documents.*, users.read
APPWRITE_API_KEY=

# AI provider (SECRET). Leave empty to use the built-in placeholder generator.
# openai | openrouter | groq | deepseek | gemini
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
# Optional: override the API base URL (any OpenAI-compatible endpoint)
AI_BASE_URL=

# Paystack (payments are not wired yet)
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
