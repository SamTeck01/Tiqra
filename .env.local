# Appwrite
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=69ffcd13000338d7832f
NEXT_PUBLIC_APPWRITE_DATABASE_ID=your-database-id

# Appwrite Collection IDs
NEXT_PUBLIC_APPWRITE_USERS_COLLECTION_ID=users
NEXT_PUBLIC_APPWRITE_SURVEYS_COLLECTION_ID=surveys
NEXT_PUBLIC_APPWRITE_RESPONSES_COLLECTION_ID=responses
NEXT_PUBLIC_APPWRITE_TRANSACTIONS_COLLECTION_ID=transactions
NEXT_PUBLIC_APPWRITE_WALLETS_COLLECTION_ID=wallets

# Paystack
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=your-paystack-public-key
PAYSTACK_SECRET_KEY=your-paystack-secret-key

NEXT_PUBLIC_USE_MOCK_API=true
